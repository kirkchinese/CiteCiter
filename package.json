{
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm check:git-entry && pnpm --dir packages/citeciter build",
    "typecheck": "pnpm --dir packages/citeciter typecheck",
    "typecheck:desktop": "node packages/citeciter/scripts/check-desktop.mjs",
    "test": "pnpm --dir packages/citeciter test",
    "sync:git-entry": "node packages/citeciter/scripts/sync-git-entry.mjs",
    "check:git-entry": "node packages/citeciter/scripts/sync-git-entry.mjs --check"
  },
  "publishConfig": {
    "directory": "packages/citeciter"
  },
  "exports": {
    ".": {
      "types": "./packages/citeciter/lib/types/index.d.ts",
      "default": "./packages/citeciter/lib/index.js"
    },
    "./client": {
      "types": "./packages/citeciter/lib/types/client/index.d.ts",
      "default": "./packages/citeciter/lib/client.js"
    },
    "./typert": {
      "types": "./packages/citeciter/lib/types/typert.host.d.ts",
      "default": "./packages/citeciter/lib/typert.host.js"
    },
    "./remote": {
      "types": "./packages/citeciter/lib/types/typert.remote-client.d.ts",
      "default": "./packages/citeciter/lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./packages/citeciter/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/citeciter/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "packages/citeciter/package.json",
    "packages/citeciter/lib/*.js",
    "packages/citeciter/lib/types/**/*.d.ts",
    "packages/citeciter/cordis.patch.yml",
    "packages/citeciter/README.zh.md"
  ],
  "name": "@kirkchinese/dsh-citeciter",
  "version": "0.9.0-alpha.4",
  "description": "Source-aware native DSH Topics with manual drafts, permissions, visual boards and learning cards",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "citation",
    "source-bound",
    "verification",
    "evidence",
    "investigation",
    "context-management",
    "read-only",
    "explanation",
    "observer",
    "topic"
  ],
  "homepage": "https://github.com/kirkchinese/CiteCiter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirkchinese/CiteCiter.git",
    "directory": "packages/citeciter"
  },
  "bugs": {
    "url": "https://github.com/kirkchinese/CiteCiter/issues"
  },
  "license": "MIT",
  "author": "kirkchinese",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "katex": "^0.18.4",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
