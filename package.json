    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/semver": "7.8.0",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
