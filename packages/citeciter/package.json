{
  "name": "@kirkchinese/dsh-citeciter",
  "version": "0.1.1",
  "description": "Selection-scoped explanation sidebar for DeepSeek Harness conversations",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "explanation",
    "sidebar"
  ],
  "homepage": "https://github.com/kirkchinese/CiteCiter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirkchinese/CiteCiter.git",
    "directory": "packages/citeciter"
  },
  "bugs": {
    "url": "https://github.com/kirkchinese/CiteCiter/issues"
  },
  "license": "MIT",
  "author": "kirkchinese",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:bundle",
    "build:lib": "tsc -p tsconfig.json",
    "build:bundle": "tsdown --env.DSH_BUILD_FACE client",
    "dev": "npm run build && node dev/watch.mjs",
    "smoke:seed": "node dev/seed-smoke-session.mjs",
    "smoke:hmr": "node dev/hmr-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:lib && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "playwright": "^1.58.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6"
  }
}