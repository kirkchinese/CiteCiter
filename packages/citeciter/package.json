{
  "name": "@kirkchinese/dsh-citeciter",
  "version": "0.4.1",
  "description": "Verifiable, source-bound, read-only investigations for DeepSeek Harness responses",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "citation",
    "source-bound",
    "verification",
    "evidence",
    "investigation",
    "context-management",
    "read-only",
    "explanation",
    "observer",
    "topic"
  ],
  "homepage": "https://github.com/kirkchinese/CiteCiter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirkchinese/CiteCiter.git",
    "directory": "packages/citeciter"
  },
  "bugs": {
    "url": "https://github.com/kirkchinese/CiteCiter/issues"
  },
  "license": "MIT",
  "author": "kirkchinese",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:bundle",
    "prebuild:lib": "node scripts/clean-types.mjs",
    "build:lib": "tsc -p tsconfig.json",
    "prebuild:bundle": "node scripts/clean-bundle.mjs",
    "build:bundle": "tsdown --env.DSH_BUILD_FACE client",
    "postbuild:bundle": "node scripts/normalize-bundle.mjs",
    "prepack": "npm run build",
    "dev": "npm run build && node dev/watch.mjs",
    "smoke:seed": "node dev/seed-smoke-session.mjs",
    "smoke:hmr": "node dev/hmr-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:lib && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-home-paths": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-output-retention": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-session-query": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-session-title": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-session-title-llm": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-subprocess": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-spill": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-tool-ask-user": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-tool-fs": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/dsh-user-questions": ">=0.1.1-rc.1 <0.1.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1",
    "playwright": "^1.58.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
